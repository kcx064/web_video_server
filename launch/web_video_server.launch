<launch>
  <node pkg="web_video_server" type="web_video_server" name="web_video_server" output="screen">
    <param name="port" type="int" value="8080" />
    <param name="address" type="string" value="192.168.137.250" />
    <param name="server_threads" type="int" value="1" />
    <param name="ros_threads" type="int" value="2" />
    <param name="width" type="int" value="1280" />
    <param name="height" type="int" value="720" />
    <param name="quality" type="int" value="90" />
    <!-- <param name="default_transport" type="string" value="compressed" /> -->
    <!-- <param name="type" type="string" value="h264" /> -->
  </node>
</launch>
